# ---------------------------------------------------------------- core
PORT=3000
BASE_URL=http://localhost:3000
# Change both of these in production.
SESSION_SECRET=cenz-dev-secret-change-me
KEY_SECRET=cenz-dev-key-secret-change-me

# ---------------------------------------------------------------- discord
# Create an app at https://discord.com/developers/applications
# OAuth2 → Redirects must include: <BASE_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=1476632255244931162
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_SCOPES=identify email guilds

# Comma-separated Discord user IDs with admin access.
ADMIN_USER_IDS=1044986769331998780

# Local sign-in by Discord ID. Defaults to on while no client secret is set.
ALLOW_DEV_LOGIN=

# ---------------------------------------------------------------- roblox
# Optional global fallback key; users normally link their own from /dashboard.
ROBLOX_API_KEY=

# ---------------------------------------------------------------- payments
# Midtrans Snap. Without a server key, orders are queued for manual activation.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=0

# ---------------------------------------------------------------- binaries
# FFMPEG_PATH=
# FFPROBE_PATH=
# YTDLP_PATH=
